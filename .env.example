# Copy to .env and fill locally. Never commit .env.
# Meta Model API (OpenAI-compatible). Base URL and key format: verify in docs/RESEARCH.md before use.
MODEL_API_KEY=
META_MODEL_BASE_URL=
# Baseten (Muse Spark Open weights, hackathon model only).
# Used when ANCHOR_BACKEND=baseten or gen_anchors.py --backend baseten.
BASETEN_API_KEY=
# Optional overrides (defaults work for the hackathon).
ANCHOR_BACKEND=meta
BASETEN_MODEL=meta-models/muse-spark-open-1026
